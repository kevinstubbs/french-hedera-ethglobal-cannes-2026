# Go control plane (see docs/RUNBOOK.md)
API_BASE_URL=http://127.0.0.1:8080

# Prepaid ledger identity for REST calls
AGENT_ID=agent-demo-1

# x402 payer wallet (EVM exact — match API X402_NETWORK / Base Sepolia by default)
X402_NETWORK=eip155:84532
X402_EVM_PRIVATE_KEY=0x

# Optional: custom RPC for the EVM chain (required if X402_NETWORK is not Base Sepolia)
# EVM_RPC_URL=https://...

# Coinbase x402 facilitator (optional on the client; server uses X402_FACILITATOR_URL)
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Hedera Agent Kit / SDK (HBAR path — see hedera-agent-kit README)
ACCOUNT_ID=0.0.x
PRIVATE_KEY=
