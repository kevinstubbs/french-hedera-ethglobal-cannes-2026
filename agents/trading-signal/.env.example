# Copy to .env and fill in secrets (do not commit .env).
# See docs/RUNBOOK.md and cmd/api/.env.example — X402_* must match the API.

# Go control plane
API_BASE_URL=http://127.0.0.1:8080

# Server: Naryo → platform event ingest (see docs/PIPELINE_EVENT_ROUTING.md)
# NARYO_INGEST_SECRET=...

# Prepaid ledger identity for REST calls (must match URL path /v1/agents/{agentId}/...)
AGENT_ID=agent-demo-1
# Demo script: auto POST .../topup/x402 when create returns 409 (default). Set to 0 to disable.
# DEMO_AUTO_PREPAID_TOPUP=0
# Minimum ledger credits to add per auto top-up (default 1000; at least API required runway).
# DEMO_PREPAID_TOPUP_MIN_UNITS=1000

# x402 payer wallet (EVM exact) — must match API X402_NETWORK (Base Sepolia below).
X402_NETWORK=eip155:84532
# Public address for the key below (debug / sanity checks; must match X402_EVM_PRIVATE_KEY).
AGENT_EVM_PUBLIC_ADDRESS=0xefd3c8d378aaa06c6c349f704680fc5d7c61a51d
# Secp256k1 private key for AGENT_EVM_PUBLIC_ADDRESS (0x-prefixed hex). Do not commit.
X402_EVM_PRIVATE_KEY=
# Payee on pipeline start — must match API X402_PAY_TO.
X402_PAY_TO=0x091f2d318dd6c3c5a92553e7b36009e7e8519e50
# Optional on Base Sepolia (viem has defaults). Uncomment if you need a custom RPC.
# EVM_RPC_URL=https://sepolia.base.org

# Coinbase x402 facilitator (optional on the client; server uses X402_FACILITATOR_URL)
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Hedera Agent Kit / direct HBAR transfers for POST .../topup/deposit (see RUNBOOK)
ACCOUNT_ID=0.0.x
PRIVATE_KEY=
