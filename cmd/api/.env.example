# Copy to .env and fill in secrets (do not commit .env).
# Load before `go run`: variables must be EXPORTED or the Go process won't see them.
#   From repo root:  set -a && source cmd/api/.env && set +a && go run ./cmd/api
#   (`source` alone sets shell vars but `go run` is a child — X402_PAY_TO etc. would be empty.)
# See docs/RUNBOOK.md for full semantics.

PORT=8080

# --- Hedera testnet (HCS audit + deposit top-up verification) ---
HEDERA_NETWORK=testnet

# Hedera operator id for topic submit + record queries
HEDERA_OPERATOR_ID=0.0.
HEDERA_OPERATOR_KEY=

# Hedera service account id for deposit top-up verification
HEDERA_SERVICE_ACCOUNT_ID=0.0.

# Hedera audit topic id for async submit
HEDERA_AUDIT_TOPIC_ID=0.0.

# Optional: force on even if topic unset — usually omit; auto-enables when operator + key + topic are set.
# HEDERA_ENABLED=true
# HEDERA_SUMMARY_WINDOW_MINUTES=10
# Demo only: skip chain verify on POST .../topup/deposit (requires amountUnits in body).
# HEDERA_SKIP_TOPUP_VERIFY=false

# --- x402 / EVM: Base Sepolia (eip155:84532) — not Ethereum Sepolia (11155111) ---
# Default facilitator (https://x402.org/facilitator) supports this network; local Anvil (31337) does not.
# Agent needs USDC on Base Sepolia for X402_PRICE. If clients get 402 with body {} after paying, verify passed
# but settlement failed — decode PAYMENT-RESPONSE on that 402 and check facilitator / payer balance / logs.
X402_NETWORK=eip155:84532
# Payee for x402 on POST .../start only. MUST be non-zero.
X402_PAY_TO=0x091f2d318dd6c3c5a92553e7b36009e7e8519e50
# USDC price per 1 second of pipeline time (quote so `source` does not expand $).
# On-chain charge for POST .../start = X402_PRICE × X402_START_RUNWAY_SECONDS (default 300).
# GET .../status is not x402 — it requires prepaid balance > 0 (running/paused + ledger).
X402_PRICE='$0.00017'
X402_START_RUNWAY_SECONDS=300

# Debug: expected EVM address of the wallet that signs x402 on the agent (not read by this binary).
AGENT_EVM_PUBLIC_ADDRESS=0xefd3c8d378aaa06c6c349f704680fc5d7c61a51d
# X402_FACILITATOR_URL=https://x402.org/facilitator

# --- Naryo (required): both must be set or the API exits on startup ---
# NARYO_SKIP_EGRESS_PROVISION=true — skips ALL Configuration API writes (no filters/broadcasters in Mongo).
# Start/resume still succeed with lastNaryoOpId=naryo-egress-skipped. For real provisioning: unset or false.
# Naryo POSTs native JSON to POST {NARYO_BROADCASTER_DEST_PATH}/{pipelineSessionId} (e.g. .../internal/naryo/v1/events/<id>).
# Same secret as manual tools: header X-Naryo-Webhook-Secret = NARYO_INGEST_SECRET. NARYO_PLATFORM_INGEST_URL must be reachable from Naryo (e.g. host.docker.internal:8080).
# If POST broadcaster-configuration async-fails (NullPointerException), API can reuse an existing HTTP config by URL or NARYO_BROADCASTER_CONFIGURATION_ID.
NARYO_CONFIG_API_BASE=http://127.0.0.1:6060
NARYO_PLATFORM_INGEST_URL=http://host.docker.internal:8080
# NARYO_BROADCASTER_DEST_PATH=/internal/naryo/v1/events
# NARYO_BROADCASTER_CONFIGURATION_ID=8b7a9c2d-1e3f-4a5b-8c9d-0e1f2a3b4c5d
# NARYO_INGEST_SECRET=
# Per-pipeline filters (from session config.eventSubscriptions on start/resume):
# NARYO_HEDERA_NODE_ID=7f3b8e1a-4d2c-4b9a-8e5f-1a2b3c4d5e6f
# NARYO_ETHEREUM_NODE_ID=eadc75b2-4217-4018-95af-f67c13058976
# NARYO_DEFAULT_HCS_TOPIC_ID=0.0.x   # optional if eventSubscriptions has no hedera_hcs_topic
NARYO_ALLOW_ALL_BROADCASTER_FALLBACK=false   # false = error when no subscription can become a filter

# --- Prepaid ledger (optional) ---
# PREPAID_DEV_AUTO_CREDIT_UNITS=100000
# PREPAID_RATE_UNITS_PER_MINUTE=1
# PREPAID_DEBIT_INTERVAL_SECONDS=300
# PREPAID_MIN_START_MINUTES=10
