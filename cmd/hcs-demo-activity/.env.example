# Copy to .env and adjust. This program loads .env automatically (no need for `source` unless you prefer it).
#
# If you use `source .env` in bash, either prefix with export or run:
#   set -a && source .env && set +a
# Otherwise child processes (go run) do not see the variables.

HEDERA_OPERATOR_ID=0.0.2
HEDERA_OPERATOR_KEY=

# Optional: same names as hedera-local-node/.env (used if HEDERA_* unset)
# RELAY_OPERATOR_ID_MAIN=0.0.2
# RELAY_OPERATOR_KEY_MAIN=...

HEDERA_NETWORK=local
HEDERA_LOCAL_PLAINTEXT=1
# Optional: longer gRPC deadline for sustained submits (default in code is 2m if unset)
# HEDERA_GRPC_DEADLINE=3m
# Optional: base URL logged on first submit for mirror tx lookup (default http://127.0.0.1:5551)
# MIRROR_REST_URL=http://127.0.0.1:5551

# HCS topic must already exist on the ledger. Create one, then paste its id:
#   go run . -create-topic
# Then: go run . -topic 0.0.<id> -interval 5s
