# Copy to .env in this directory; docker compose loads it automatically.
# See docs/NARYO_VERIFY.md for the full Naryo verification flow.

# Optional: pin a digest tag if broadcaster-configuration create NPEs on :latest (see cmd/api NARYO_BROADCASTER_CONFIGURATION_ID).
# NARYO_IMAGE=ghcr.io/lf-decentralized-trust-labs/naryo:sha-001c9a2
# Must match cmd/api NARYO_PLATFORM_INGEST_URL (declarative seed in application.yml).
# NARYO_DECLARATIVE_HTTP_INGEST_URL=http://host.docker.internal:8080

# --- Ethereum: Base Sepolia (84532) — EVM_RPC_URL in application.yml (no local Anvil in this compose file) ---
# Compose default is https://sepolia.base.org. For reliable Naryo startup + filters, prefer a dedicated URL:
# EVM_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# --- Hedera testnet + HCS topic (public mirror; Naryo reads mirror REST only) ---
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
LOCAL_NODE_HCS_TOPIC_ID=0.0.8510924

# --- Local hedera-local-node (default if you omit .env) ---
# HEDERA_MIRROR_URL=http://host.docker.internal:5551
# LOCAL_NODE_HCS_TOPIC_ID=0.0.your-local-topic

