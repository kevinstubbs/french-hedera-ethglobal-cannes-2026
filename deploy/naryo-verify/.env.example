# Copy to .env in this directory; docker compose loads it automatically.
# See docs/NARYO_VERIFY.md for the full Naryo verification flow.

# --- Hedera testnet + HCS topic (public mirror; Naryo reads mirror REST only) ---
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
LOCAL_NODE_HCS_TOPIC_ID=0.0.8510924

# --- Local hedera-local-node (default if you omit .env) ---
# HEDERA_MIRROR_URL=http://host.docker.internal:5551
# LOCAL_NODE_HCS_TOPIC_ID=0.0.your-local-topic

# Deprecated alias for topic id (optional):
# SOLO_HCS_TOPIC_ID=0.0.8510924
